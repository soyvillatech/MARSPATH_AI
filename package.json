{
  "name": "marspath-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "api": "uv run --no-project --python .venv/Scripts/python.exe -m uvicorn backend.app:app --host 127.0.0.1 --port 8000",
    "terrain:prepare": "uv run --no-project --python .venv/Scripts/python.exe scripts/prepare_terrain.py",
    "test:terrain": "uv run --no-project --python .venv/Scripts/python.exe -m pytest backend -q"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
